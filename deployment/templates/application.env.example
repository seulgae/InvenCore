# Sanitized EXAMPLE only. The bootstrap script generates the JWT secret on the server.
JWT_SECRET=REPLACE_ON_SERVER_WITH_RANDOM_VALUE
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
CORS_ORIGINS=https://YOUR_DOMAIN
FILE_UPLOAD_DIR=/var/lib/invencore/uploads
FEATURE_SERVER_CAPACITY_ENABLED=false
GW_SYNC_MODE=external
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
GW_SYNC_ENABLED=true
BENCHMARK_ROWS=300000
JAVA_TOOL_OPTIONS="-Xms128m -Xmx768m"
DB_URL=jdbc:postgresql://127.0.0.1:5432/invencore
DB_USERNAME=invencore
DB_PASSWORD=REPLACE_WITH_EXISTING_DATABASE_PASSWORD
