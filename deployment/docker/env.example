# Public example only. Generate JWT_SECRET separately; do not commit real secrets.
# Preserve the existing .env.docker; do not replace it with this template.
FRONTEND_PORT=8082
APP_IMAGE_TAG=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,https://seulgae-server.tailac4b36.ts.net
GW_SYNC_ENABLED=true
GW_SYNC_MODE=external
INFRA_NETWORK=invencore-infra-net
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
REDIS_HOST=redis
REDIS_PORT=6379
# Existing Redis currently has no authentication; set these only when configured there.
REDIS_USERNAME=
REDIS_PASSWORD=
BENCHMARK_ROWS=300000
# Existing PostgreSQL has no host-published port. Connect it to INFRA_NETWORK first.
# Use the actual container DNS/database/account already provisioned on the server.
DB_URL=jdbc:postgresql://postgres-postgres-1:5432/homeserver
DB_USERNAME=appuser
DB_PASSWORD=REPLACE_WITH_EXISTING_DATABASE_PASSWORD
