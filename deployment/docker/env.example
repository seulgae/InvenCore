# Public example only. Generate JWT_SECRET separately; do not commit real secrets.
# Start alongside the old docker-run containers on 8082, then switch frontend only.
FRONTEND_PORT=8082
APP_IMAGE_TAG=local
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
GW_SYNC_ENABLED=true
BENCHMARK_ROWS=300000
