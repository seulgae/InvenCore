[Unit]
Description=Collect InvenCore Ubuntu host capacity snapshot

[Service]
Type=oneshot
User=invencore-monitor
Group=invencore-monitor
StateDirectory=invencore-host-capacity
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 /usr/local/lib/invencore-monitor/collect-host-capacity.py --output /var/lib/invencore-host-capacity/capacity.json
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
TimeoutStartSec=5
