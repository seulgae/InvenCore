[Unit]
Description=InvenCore on-demand Ubuntu host capacity query service

[Service]
Type=simple
User=invencore-monitor
Group=invencore-monitor
RuntimeDirectory=invencore-host
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /usr/local/lib/invencore-monitor/collect-host-capacity.py --socket /run/invencore-host/capacity.sock
Restart=on-failure
RestartSec=2
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
TimeoutStartSec=5

[Install]
WantedBy=multi-user.target
