root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.java]
indent_size = 4
ij_java_blank_lines_around_method = 1
ij_java_blank_lines_around_method_in_interface = 1

[*.xml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
